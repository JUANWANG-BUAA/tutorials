; Perturbation relative bound from explicitly assumed norm inequalities
; Source: numerical/src/course/ch02/sec23.md#sec-2.3.1
; Real arithmetic is exact. No floating-point values are used.
(set-logic QF_NRA)
(set-option :timeout 15000)
(declare-const e Real)
(declare-const v Real)
(declare-const r Real)
(declare-const d Real)
(declare-const x Real)
(declare-const a Real)
(declare-const b Real)
(assert (>= e 0))
(assert (>= v 0))
(assert (>= r 0))
(assert (>= d 0))
(assert (> x 0))
(assert (> a 0))
(assert (> b 0))
(assert (< (* v d) 1))
(assert (<= b (* a x)))
(assert (<= e (+ (* v r) (* v d x) (* v d e))))
(check-sat)
(push 1)
(assert (not (<= (* e b (- 1 (* v d))) (* v x (+ (* a r) (* d b))))))
(check-sat)
(pop 1)
